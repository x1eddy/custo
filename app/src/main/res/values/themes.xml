<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash: the Custo mark on its lavender, then straight into the app. -->
    <style name="Theme.Custo" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/custo_ink</item>
        <item name="android:windowSplashScreenBackground">#FFF3F0FF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_fg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FFF3F0FF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
