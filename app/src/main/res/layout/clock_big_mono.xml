<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:orientation="vertical">
    <TextClock android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="h:mm" android:format24Hour="HH:mm" android:fontFamily="monospace"
        android:textStyle="bold" android:textSize="56sp" android:includeFontPadding="false" />
    <TextClock android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="EEEE, MMM d" android:format24Hour="EEEE, d MMM" android:fontFamily="monospace" android:textSize="15sp" />
</LinearLayout>
