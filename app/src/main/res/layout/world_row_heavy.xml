<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="2dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="2" android:shadowRadius="0.01"
        android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="@font/custo_heavy" android:textAllCaps="true" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
        <TextClock android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="2" android:shadowRadius="0.01"
        android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="EEE" android:format24Hour="EEE" android:fontFamily="@font/custo_heavy" android:textAllCaps="true" android:textSize="12sp" android:alpha="0.7" />
    </LinearLayout>
    <TextClock android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="5" android:shadowRadius="0.01"
        android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:fontFamily="@font/custo_heavy" android:textAllCaps="true"
        android:textSize="26sp" android:includeFontPadding="false" />
</LinearLayout>
