<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center_vertical|start" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="12dp">
    <TextClock android:shadowColor="#B3202020" android:shadowDx="2" android:shadowDy="2" android:shadowRadius="0.01"
        android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="EEEE" android:format24Hour="EEEE" android:fontFamily="@font/custo_pixel" android:textSize="14sp" android:alpha="0.8" />
    <TextClock android:shadowColor="#B3202020" android:shadowDx="5" android:shadowDy="5" android:shadowRadius="0.01"
        android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:fontFamily="@font/custo_pixel" android:textSize="34sp" />
</LinearLayout>
