<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:orientation="vertical">
    <TextClock android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="hh" android:format24Hour="HH" android:fontFamily="sans-serif"
        android:textStyle="bold" android:textSize="64sp" android:includeFontPadding="false" android:lineSpacingMultiplier="0.8" />
    <TextClock android:id="@+id/time2" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="mm" android:format24Hour="mm" android:fontFamily="sans-serif"
        android:textStyle="bold" android:textSize="64sp" android:includeFontPadding="false" android:alpha="0.7" />
    <TextClock android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="EEE d" android:format24Hour="EEE d" android:fontFamily="sans-serif" android:textSize="14sp" />
</LinearLayout>
