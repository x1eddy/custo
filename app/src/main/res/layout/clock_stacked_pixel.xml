<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:orientation="vertical">
    <TextClock android:shadowColor="#B3202020" android:shadowDx="5" android:shadowDy="5" android:shadowRadius="0.01"
        android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="hh" android:format24Hour="HH" android:fontFamily="@font/custo_pixel"
        android:textSize="64sp" android:includeFontPadding="false" android:lineSpacingMultiplier="0.8" />
    <TextClock android:shadowColor="#B3202020" android:shadowDx="5" android:shadowDy="5" android:shadowRadius="0.01"
        android:id="@+id/time2" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="mm" android:format24Hour="mm" android:fontFamily="@font/custo_pixel"
        android:textSize="64sp" android:includeFontPadding="false" android:alpha="0.7" />
    <TextClock android:shadowColor="#B3202020" android:shadowDx="2" android:shadowDy="2" android:shadowRadius="0.01"
        android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="EEE d" android:format24Hour="EEE d" android:fontFamily="@font/custo_pixel" android:textSize="14sp" />
</LinearLayout>
