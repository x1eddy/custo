<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Shizuku API permission (granted at runtime by the Shizuku app). -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />
    <!-- Re-apply status bar flags and re-arm the day/night wallpaper switch after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Default ringtone pickers; granted through Shizuku (appops), never asked from the user. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- Control Center: Wi-Fi tile state and Do Not Disturb (only after the user grants access). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />
    <!-- Lets Custo find the Shizuku app to show setup status. -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <!-- Installed icon packs (ADW / Nova / GO / Apex formats). -->
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
        <intent><action android:name="com.anddoes.launcher.THEME" /></intent>
    </queries>

    <application
        android:name=".CustoApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Custo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <service
            android:name=".feature.overlays.CustoAccessibilityService"
            android:exported="false"
            android:label="Custo overlays"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_config" />
        </service>

        <service
            android:name=".feature.overlays.CustoNotificationListener"
            android:exported="false"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver android:name=".feature.widgets.ClockReceiver" android:exported="false" android:label="Custo clock">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /><action android:name="android.intent.action.LOCALE_CHANGED" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_clock" />
        </receiver>
        <receiver android:name=".feature.widgets.AnalogReceiver" android:exported="false" android:label="Custo analog clock">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_analog" />
        </receiver>
        <receiver android:name=".feature.widgets.HourReceiver" android:exported="false" android:label="Custo big hour">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /><action android:name="android.intent.action.LOCALE_CHANGED" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_hour" />
        </receiver>
        <receiver android:name=".feature.widgets.WorldReceiver" android:exported="false" android:label="Custo world clock">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /><action android:name="android.intent.action.LOCALE_CHANGED" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_world" />
        </receiver>
        <receiver android:name=".feature.widgets.StopwatchReceiver" android:exported="false" android:label="Custo stopwatch">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_stopwatch" />
        </receiver>
        <receiver android:name=".feature.widgets.DateReceiver" android:exported="false" android:label="Custo date">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /><action android:name="android.intent.action.TIME_SET" /><action android:name="android.intent.action.TIMEZONE_CHANGED" /><action android:name="android.intent.action.LOCALE_CHANGED" /><action android:name="android.intent.action.DATE_CHANGED" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_date" />
        </receiver>
        <receiver android:name=".feature.widgets.CalendarReceiver" android:exported="false" android:label="Custo calendar">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /><action android:name="android.intent.action.TIME_SET" /><action android:name="android.intent.action.TIMEZONE_CHANGED" /><action android:name="android.intent.action.LOCALE_CHANGED" /><action android:name="android.intent.action.DATE_CHANGED" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_calendar" />
        </receiver>
        <receiver android:name=".feature.widgets.CountdownReceiver" android:exported="false" android:label="Custo countdown">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /><action android:name="android.intent.action.TIME_SET" /><action android:name="android.intent.action.TIMEZONE_CHANGED" /><action android:name="android.intent.action.LOCALE_CHANGED" /><action android:name="android.intent.action.DATE_CHANGED" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_countdown" />
        </receiver>
        <receiver android:name=".feature.widgets.BatteryReceiver" android:exported="false" android:label="Custo battery">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_battery" />
        </receiver>
        <receiver android:name=".feature.widgets.BatteryRingReceiver" android:exported="false" android:label="Custo battery ring">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_battery_ring" />
        </receiver>
        <receiver android:name=".feature.widgets.AlarmReceiver" android:exported="false" android:label="Custo next alarm">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /><action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" /><action android:name="android.intent.action.TIME_SET" /><action android:name="android.intent.action.TIMEZONE_CHANGED" /><action android:name="android.intent.action.LOCALE_CHANGED" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_alarm" />
        </receiver>
        <receiver android:name=".feature.widgets.StorageReceiver" android:exported="false" android:label="Custo storage">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_storage" />
        </receiver>
        <receiver android:name=".feature.widgets.MediaReceiver" android:exported="false" android:label="Custo now playing">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_media" />
        </receiver>
        <receiver android:name=".feature.widgets.PhotoReceiver" android:exported="false" android:label="Custo photo">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_photo" />
        </receiver>
        <receiver android:name=".feature.widgets.NoteReceiver" android:exported="false" android:label="Custo note">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_note" />
        </receiver>

        <!-- System UI extras -->
        <receiver android:name=".feature.systemui.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service android:name=".feature.systemui.CaffeineTile" android:exported="true"
            android:label="@string/tile_caffeine" android:icon="@drawable/ic_tile_coffee"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".feature.systemui.ExtraDimTile" android:exported="true"
            android:label="@string/tile_extra_dim" android:icon="@drawable/ic_tile_dim"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".feature.systemui.HeadsUpTile" android:exported="true"
            android:label="@string/tile_heads_up" android:icon="@drawable/ic_tile_popup"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".feature.systemui.ScreenshotModeTile" android:exported="true"
            android:label="@string/tile_screenshot" android:icon="@drawable/ic_tile_screenshot"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".feature.systemui.PrivateDnsTile" android:exported="true"
            android:label="@string/tile_private_dns" android:icon="@drawable/ic_tile_dns"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".feature.systemui.WirelessDebuggingTile" android:exported="true"
            android:label="@string/tile_wireless_debugging" android:icon="@drawable/ic_tile_adb"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <receiver android:name=".feature.widgets.AppsReceiver" android:exported="false" android:label="Custo app shortcuts">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_apps" />
        </receiver>
        <receiver android:name=".feature.widgets.TogglesReceiver" android:exported="false" android:label="Custo quick toggles">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_toggles" />
        </receiver>
        <receiver android:name=".feature.widgets.QuoteReceiver" android:exported="false" android:label="Custo daily quote">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /><action android:name="android.intent.action.TIME_SET" /><action android:name="android.intent.action.TIMEZONE_CHANGED" /><action android:name="android.intent.action.LOCALE_CHANGED" /><action android:name="android.intent.action.DATE_CHANGED" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quote" />
        </receiver>

        <service
            android:name=".feature.themes.LiveWallpaperService"
            android:exported="true"
            android:label="@string/live_wallpaper_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter><action android:name="android.service.wallpaper.WallpaperService" /></intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/live_wallpaper" />
        </service>
        <service
            android:name=".feature.themes.VideoWallpaperService"
            android:exported="true"
            android:label="@string/video_wallpaper_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter><action android:name="android.service.wallpaper.WallpaperService" /></intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/video_wallpaper" />
        </service>
        <receiver android:name=".feature.themes.WallScheduleReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
